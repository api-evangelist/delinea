{
  "opencollection": "1.0.0",
  "info": {
    "name": "Secret Server Rest Activations CharacterSets API",
    "version": "11.7.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "CharacterSets",
        "type": "folder"
      },
      "items": [

{
  "opencollection": "1.0.0",
  "info": {
    "name": "Secret Server Rest Activations RestApiDocs API",
    "version": "11.7.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "RestApiDocs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get REST API Services",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/SecretServer/api/v1/rest-documentation/services"
          },
          "docs": "Return a list of all REST API service names"
        }
      ]
    }
  ],
  "bundled": true
}